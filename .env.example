# Copy this file to backend/.env and fill in the keys you actually have.
# A provider only appears in the app when its key is set.
# The "mock" provider always works and needs no key (for development/testing).

OPENAI_API_KEY=sk-your-openai-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# Embeddings power the document Q&A (RAG). "openai" (text-embedding-3-small) is the
# default when OPENAI_API_KEY is set; "mock" works offline with deterministic vectors.
EMBEDDING_PROVIDER=openai
